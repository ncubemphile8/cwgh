# Copy to .env.local for local development.
# Never commit real values or service-role keys.

NEXT_PUBLIC_SITE_URL=https://www.cwgh.co.zw

# Supabase project settings (required only when production staff portal integration is enabled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional transactional email provider for staff invitations and reminders
RESEND_API_KEY=
CWGH_FROM_EMAIL=

# Optional map provider for field activity maps
NEXT_PUBLIC_MAPTILER_KEY=
